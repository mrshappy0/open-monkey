{
  "name": "openmonkey",
  "description": "Lightweight, privacy-respecting userscript manager Chrome extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "openmonkey": "./native-host/dist/index.js"
  },
  "files": [
    "native-host/dist"
  ],
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "prepare": "tsc -p tsconfig.mcp.json && node --input-type=module -e \"import{readFileSync,writeFileSync}from'fs';const f='native-host/dist/index.js';writeFileSync(f,'#!/usr/bin/env node\\n'+readFileSync(f,'utf8'));\"\n",
    "postinstall": "node -e \"if(process.env.npm_config_global||!process.env.INIT_CWD||process.env.INIT_CWD===process.cwd())process.exit(0)\" || wxt prepare"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@wxt-dev/storage": "^1.2.8",
    "react": "^19.2.6",
    "react-dom": "^19.2.5",
    "ws": "^8.20.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.42",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.5.14",
    "@wxt-dev/module-react": "^1.2.2",
    "tsx": "^4.19.4",
    "typescript": "^6.0.3",
    "wxt": "^0.20.26"
  },
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
