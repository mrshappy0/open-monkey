{
  "name": "openmonkey",
  "description": "Lightweight, privacy-respecting userscript manager Chrome extension",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "bin": {
    "openmonkey": "./native-host/dist/index.js"
  },
  "files": [
    "native-host/dist"
  ],
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "prepare": "tsc -p tsconfig.mcp.json && node --input-type=module -e \"import{readFileSync,writeFileSync}from'fs';const f='native-host/dist/index.js';writeFileSync(f,'#!/usr/bin/env node\\n'+readFileSync(f,'utf8'));\"\n",
    "postinstall": "node -e \"if(process.env.npm_config_global||!process.env.INIT_CWD||process.env.INIT_CWD===process.cwd())process.exit(0)\" || wxt prepare"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@wxt-dev/storage": "^1.2.8",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "ws": "^8.20.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint-react/eslint-plugin": "^5.7.8",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@types/chrome": "^0.1.42",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.5.14",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ip-address": "10.2.0",
    "semantic-release": "^25.0.3",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "wxt": "^0.20.26"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.1.2",
  "pnpm": {
    "overrides": {
      "ip-address": "^10.2.0"
    }
  }
}
